        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "C",
          "expr": "sum(ach_dbt_nodes{resource_type=\"test\", status=~\"fail|error\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
