# Copy to .env. Values are unquoted on purpose: Docker's --env-file does not
# strip quotes the way python-dotenv and shells do.

# --- Synthetic data ---------------------------------------------------------
ACH_SEED=42
ACH_HISTORY_DAYS=60
ACH_HISTORY_END=2026-08-31

# --- Paths (container defaults; local runs use repo-relative defaults) -------
# ACH_LAKE_ROOT=/opt/airflow/data/lake
# ACH_WAREHOUSE_PATH=/opt/airflow/data/warehouse/ach.duckdb

# --- LLM triage (litellm model string; provider is the prefix) --------------
# Local, free, nothing leaves the machine:
TRIAGE_MODEL=ollama_chat/qwen3:4b
# From inside Docker, the Mac's Ollama is reachable at host.docker.internal.
OLLAMA_API_BASE=http://host.docker.internal:11434
# Hosted alternatives -- set the key and swap the model string:
# TRIAGE_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=...
# TRIAGE_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=...

# --- Monitoring (leave empty to disable pushes, e.g. in CI) -----------------
PUSHGATEWAY_URL=http://pushgateway:9091
GRAFANA_URL=http://grafana:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Airflow (docker compose) ----------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__API_AUTH__JWT_SECRET=change-me-in-anything-but-a-laptop-demo
